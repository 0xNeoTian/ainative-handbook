{
  "name": "ainative-handbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-plugin.mjs && next build",
    "build:plugin": "node scripts/build-plugin.mjs",
    "scan": "node scripts/scan.mjs",
    "test:docs": "node scripts/test-docs.mjs",
    "test:plugin": "python3 -I -B tests/plugin/test_merge.py && python3 -I -B tests/plugin/test_doctor.py",
    "check": "bun run scan && bun run test:docs && bun run test:plugin && bun run types:check",
    "start": "serve out",
    "deploy": "wrangler deploy",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "cn": "^0.4.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.5",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsonc-parser": "^3.3.1",
    "postcss": "^8.5.28",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  }
}
